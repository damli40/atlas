{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src", "server", "web", "runners", "tests", "tools", "plugins", "bench", "vite.config.ts"],
  "exclude": ["bench/truth/cases", "bench/truth-2/cases", "bench/models/cases"]
}
