# Copy to .env (never committed) and fill in. The server reads .env itself at startup (server/load-env.ts):
# a variable already set in your shell wins, an empty value is skipped, and no value is ever printed.
# Keep real values out of git.

# A Base mainnet RPC with archive state (reads at old blocks), used by the EVM runner and anvil forks.
# Without it the Moonwell (pull request) flow says so; the TypeScript flow still works.
BASE_RPC_URL=
# Meta API key for the model roles (or ~/.config/meta-model-api/env). Without it every model slot says "no Meta API key".
META_API_KEY=
# Baseten API key for Muse Spark Open, the open-weights bettor (or ~/.config/baseten/env). Without it that choice is off.
BASETEN_API_KEY=
# Optional GitHub token for reading pull requests (unauthenticated reads are rate-limited by GitHub).
GITHUB_TOKEN=

# Muse Code (`muse exec`) runs only inside macOS sandbox-exec. On Linux or Windows, Atlas asks for changes
# through the muse-spark-1.3 chat instead (no file access). Needs Node 22.13 or newer (node --permission).
