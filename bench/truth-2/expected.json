  "functions": [
    {
      "id": "h01",
      "file": "cases/h01-cpu-elapsed.js",
      "language": "js",
      "category": "cpu timing",
      "tests": [
        {
          "id": "h01a",
          "exportName": "timeWork",
          "args": [],
          "expect": {
            "outcome": "returned",
            "returnedJson": {
              "dependsOn": "clock"
            },
            "virtualMs": 0,
            "wholeRunCantCheckOk": "clock",
            "returnedType": "object"
          },
          "why": "The function times CPU work with Date.now() and performance.now(). A real run measures about 100 ms; Atlas's clock does not move during CPU work, so the returned numbers are about Atlas's clock, not the code. Honest: the returned value is not reported as a plain fact (or the whole run is can't-check for that reason). The call does return an object at virtual time 0."
        },
        {
          "id": "h01b",
          "exportName": "spinWait",
          "args": [],
          "expect": {
            "cantCheck": true,
            "because": "A busy-wait on Date.now() never ends on a clock that only moves when the code is idle; a real run returns 'waited' after 50 ms. Atlas cannot run it honestly.",
            "reasonCategory": [
              "clock",
              "real-time"
            ]
          },
          "why": "Busy-wait. Can't check (safe), with a clock or real-time reason."
        }
      ]
    },
    {
      "id": "h02",
      "file": "cases/h02-unref.js",
      "language": "js",
      "category": "unref",
      "tests": [
        {
          "id": "h02a",
          "exportName": "unrefWait",
          "args": [],
          "expect": {
            "outcome": {
              "dependsOn": "process-lifetime"
            },
            "wholeRunCantCheckOk": "process-lifetime"
          },
          "why": "The wait is on an unref'd timer. Awaited inside a process that something else keeps alive, it returns 'done' at 100 ms; called from a plain script, the process exits first and the call never ends. Which one is true depends on the caller, not the code. Honest: how the call ends is not reported as a plain fact. (The review rated this one minor: context-dependent.)"
        },
        {
          "id": "h02b",
          "exportName": "abortOnly",
          "args": [],
          "expect": {
            "outcome": {
              "dependsOn": "process-lifetime"
            },
            "wholeRunCantCheckOk": "process-lifetime"
          },
          "why": "AbortSignal.timeout's timer is unref'd in Node too; same as h02a."
        }
      ]
    },
