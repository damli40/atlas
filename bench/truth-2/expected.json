          ],
          "expect": {
            "outcome": "returned",
            "returnedJson": 3,
            "returnedType": "number",
            "virtualMs": 3,
            "calls": {
              "cb": 3
            }
          },
          "why": "setInterval 0 ms (really 1 ms) cleared after 3 ticks: returns 3 at 3 ms; cb called 3 times. Real Node agrees (review step 3)."
        },
        {
          "id": "h05b",
