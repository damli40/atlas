{
 "source": "function sleep(ms) {\n  return new Promise((r) => setTimeout(r, ms));\n}\nfunction withTimeout(p, ms) {\n  return Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error(\"timeout\")), ms))]);\n}\nexport async function fetchWithRetry(fetchIt, attempts = 3) {\n  let last;\n  for (let i = 0; i < attempts; i++) {\n    try {\n      return await withTimeout(fetchIt(), 1000);\n    } catch (e) {\n      last = e;\n      await sleep(100 * 2 ** i);\n    }\n  }\n  throw last;\n}\n",
