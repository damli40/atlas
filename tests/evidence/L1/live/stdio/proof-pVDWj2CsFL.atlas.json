    "language": "ts",
    "source": "// Retries a call, waiting longer after each failure.\nexport async function retryWithBackoff(fetchIt: () => Promise<unknown>, attempts: number = 3, baseMs: number = 100) {\n  let last: unknown;\n  for (let i = 0; i < attempts; i++) {\n    try {\n      return await fetchIt();\n    } catch (e) {\n      last = e;\n      await new Promise((r) => setTimeout(r, baseMs));\n    }\n  }\n  throw last;\n}\n"
  },
